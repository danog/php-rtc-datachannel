{
  "name": "quasarstream/datachannel",
  "type": "library",
  "description": "A PHP implementation of WebRTC's RTCDataChannel interface for bidirectional peer-to-peer data communication.",
  "keywords": [
    "webrtc",
    "datachannel"
  ],
  "homepage": "https://www.quasarstream.com/webrtc",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Amin Yazdanpanah",
      "email": "github@aminyazdanpanah.com"
    },
    {
      "name": "Sana Moniri",
      "email": "s.mo@quasarstream.com"
    },
    {
      "name": "Quasar Stream Community",
      "homepage": "https://quasarstream.com/teams"
    }
  ],
  "require": {
    "php": "^8.4",
    "quasarstream/exception": "^1.0",
    "quasarstream/sctp": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/php-code-coverage": "11.0.x-dev",
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "Webrtc\\DataChannel\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Webrtc\\DataChannel\\": "tests"
    }
  },
  "minimum-stability": "dev"
}